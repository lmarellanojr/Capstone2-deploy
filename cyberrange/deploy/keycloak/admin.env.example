# Keycloak admin credentials (used by keycloak.service EnvironmentFile=/etc/keycloak/admin.env)
#
# IMPORTANT: This is a template. Copy to admin.env and fill in KEYCLOAK_ADMIN_PASSWORD before deploying.
#
# Secrets handling:
# - DO NOT commit admin.env (add to .gitignore)
# - File mode: 600 (owner read/write only)
# - Loaded via EnvironmentFile=/etc/keycloak/admin.env in keycloak.service
# - NEVER inline password in Environment= directive

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=${KEYCLOAK_ADMIN_PASSWORD}
