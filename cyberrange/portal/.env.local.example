# Ampere Path B (guacamole nginx is the student origin).
# Copy on the host:  install -m 600 .env.local.example .env.local
# Then fill KEYCLOAK_CLIENT_SECRET and NEXTAUTH_SECRET. Never commit .env.local.
# Chapter 04 uses the Path B NEXTAUTH_URL. Chapter 07 flips it to https://<TUNNEL_HOST>.

NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_SCORING_URL=
API_INTERNAL_URL=http://10.115.77.1:5000

# Scenario 06 browser scoring (#109). Must match the provision API value in env/.env.
# openssl rand -hex 32 — if unset, Open DVWA still loads but browser milestones are not recorded.
BROWSER_SCORE_SECRET=

KEYCLOAK_CLIENT_ID=portal
KEYCLOAK_CLIENT_SECRET=
# Native Keycloak uses --http-relative-path=/auth. Bare :8083/realms/... 404s.
KEYCLOAK_ISSUER=http://10.115.77.12/auth/realms/cyber-range
# Server-side token POST must stay Path B even after Chapter 07 (public HTTPS 401).
KEYCLOAK_SERVER_SIDE_ISSUER=http://10.115.77.12/auth/realms/cyber-range
# Browser/logout issuer. Chapter 04: same as KEYCLOAK_ISSUER. Chapter 07: https://<TUNNEL_HOST>/auth/realms/cyber-range
KEYCLOAK_PUBLIC_ISSUER=http://10.115.77.12/auth/realms/cyber-range

# openssl rand -base64 32 — only in this file, never also in .env.production
NEXTAUTH_SECRET=<generate-with-openssl-rand>
# Chapter 04 (private path). Chapter 07 replaces with https://<TUNNEL_HOST>
NEXTAUTH_URL=http://10.115.77.12

NODE_ENV=production
