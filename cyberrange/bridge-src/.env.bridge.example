# Cyber Range web-terminal bridge config. Copy to .env.bridge and set real secrets.
AUTH_ENABLED=true
# Discover the current gateway container address with:
#   lxc list guacamole -c4 --format csv | cut -d' ' -f1
KEYCLOAK_INTROSPECT_URL=http://GATEWAY_CONTAINER_IP/auth/realms/cyber-range/protocol/openid-connect/token/introspect
KEYCLOAK_CLIENT_ID=portal
KEYCLOAK_CLIENT_SECRET=<redacted>
PROVISION_API_URL=http://10.115.77.1:5000
# Bind on lxdbr0 (10.115.77.1): the host is NOT an L3 member of the OVN mgmt-net,
# so 10.0.10.11 is unbindable. lxdbr0 is reachable from the guacamole container
# (where nginx runs) and is NOT exposed on the LAN/tailscale interfaces.
BRIDGE_BIND_HOST=10.115.77.1
BRIDGE_BIND_PORT=8765
