# OCI Always Free — 2 OCPU / 12 GiB Ampere A1 (aarch64), 200 GiB block.
# The provision-api unit reads THIS path (mode 600):
#   [ -f env/.env ] || install -m 600 env/oci-12gib.env.example env/.env
#   chmod 600 env/.env
# Do NOT copy this file to ~/cyberrange/.env — that path is not EnvironmentFile=.
#
# Always Free on this shape is 2 OCPU / 12 GiB (not the older 4 / 24).
# PROFILE=oci_12gib must stay set; the code defaults to onprem if PROFILE is unset.

PROFILE=oci_12gib

# PROFILE already implies every value in this block. They are spelled out
# because this is the file an operator reads when the host is misbehaving.
MAX_PODS=1
POD_RAM_MB=4096
RAM_BUFFER_MB=1536
POD_STORAGE_MB=7168
STORAGE_LIMIT_MB=180000

# Verify after start-up — this must report 1536, not 2048:
#   curl -s http://10.115.77.1:5000/capacity

API_BIND_HOST=10.115.77.1
API_BIND_PORT=5000
DB_PATH=/home/llms_admin/cyberrange-data/pod_mgmt.db

AUTH_ENABLED=true
KEYCLOAK_CLIENT_ID=portal
# Generate on the host; never commit the live value.
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_INTROSPECT_URL=http://10.115.77.12/auth/realms/cyber-range/protocol/openid-connect/token/introspect
# ADM-USER (#32): service-account client for Admin user management
# (/admin/users). Written by deploy/host/setup_user_admin_client.sh; if unset,
# /admin/users answers 503 and nothing else is affected. Keycloak base URL and
# realm are derived from KEYCLOAK_INTROSPECT_URL unless KEYCLOAK_BASE_URL /
# KEYCLOAK_REALM are set.
KEYCLOAK_USER_ADMIN_CLIENT_ID=cyberrange-user-admin
KEYCLOAK_USER_ADMIN_CLIENT_SECRET=

# Wazuh runs MANAGER-ONLY on this shape. No indexer, no dashboard.
# Use the hostname "localhost", NOT 127.0.0.1. The Wazuh API server cert carries
# `subjectAltName = DNS:localhost` and no IP SAN, so https://127.0.0.1:55000
# fails TLS hostname verification whenever WAZUH_TLS_VERIFY=true (the default).
# The LXD proxy device listens on 127.0.0.1:55000; "localhost" resolves there.
# WAZUH_API_URL=https://localhost:55000
# Dedicated read-only API user; do NOT reuse the built-in wazuh / wazuh-wui
# accounts, which ship with default passwords and the administrator role.
# WAZUH_SCORING_USER=scoring
# WAZUH_SCORING_PW=
# Pin trust to the extracted API cert instead of disabling verification:
# WAZUH_CA_BUNDLE=/home/llms_admin/cyberrange/certs/wazuh-api.crt

# Student DVWA is same-origin /lab/dvwa/ through the portal. Leave LAB_PUBLIC_HOST
# empty on Ampere so :18301 is not advertised. Do NOT set this to the Oracle
# public IP. A non-empty value is only for a trusted LAN bind.
# LAB_PUBLIC_HOST=
